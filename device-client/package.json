{
  "name": "signage-device-client",
  "private": true,
  "version": "1.0.0",
  "description": "Signage device player (web + aplikasi desktop Electron)",
  "author": "Signage Control Panel",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5174 && electron . --dev\"",
    "electron:start": "vite build --mode electron && electron .",
    "electron:build": "vite build --mode electron && electron-builder"
  },
  "build": {
    "appId": "id.mjsolution.signage.player",
    "productName": "Signage Player",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  }
}
